<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Godot 4.2+ 通过该 meta-data 发现并实例化插件 -->
        <meta-data
            android:name="org.godotengine.plugin.v2.KnightUpdate"
            android:value="com.udokw.knightupdate.KnightUpdate" />

        <!-- 只给自己的下载文件开 content:// 读取权限，不对外导出 -->
        <provider
            android:name="com.udokw.knightupdate.ApkProvider"
            android:authorities="${applicationId}.knightupdate.files"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
