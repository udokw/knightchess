; Engine configuration file.
config_version=5

[application]

config/name="骑士飞行棋3 - Godot复刻"
config/version="1.0.2"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.png"
run/max_fps=30

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
; 窗口拉大时直接扩展画布，而不是把 1280x720 拉伸放大（否则整体发虚）
window/stretch/aspect="expand"
window/handheld/orientation=0

[gui]

theme/custom="res://assets/theme/app_theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/compression/compress_with_gpu=true
textures/vram_compression/import_etc2_astc=true
; 移动端发热优化：关闭 3D MSAA，纹理过滤降一档
anti_aliasing/quality/msaa_3d=0
textures/default_filters/anisotropic_filtering_level=1
; 3D 渲染分辨率 85%（HUD 保持清晰），进一步降低 GPU 负载 / 发热 / 耗电
scaling_3d/scale=0.85
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.07, 1)
